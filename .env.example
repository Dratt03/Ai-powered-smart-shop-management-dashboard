# PostgreSQL Database Configuration (Required for Docker)
# Set your secure database password before running 'docker compose up'
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=shopkeeper_db

# Local PostgreSQL Connection URL (Used when running without Docker)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/shopkeeper_db

# Google Gemini AI Configuration
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
